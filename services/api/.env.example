JWT_SECRET_KEY=change-me-generate-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=30
RESEND_API_KEY=re_xxxxxxxxxxxxxx
RESEND_FROM=HealthCore <no-reply@healthcore.com>
FRONTEND_BASE_URL=http://localhost:3000
# ── Rate limiting (forgot-password) ──────────────────────────
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MINUTES=60
# ── Auditoría de restablecimiento de contraseña ─────────────
PASSWORD_RESET_AUDIT_ENABLED=true
